[Unit]
Description=Blockhead Consulting Website
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=lance
Group=lance
WorkingDirectory=/home/lance/Blockhead.Consulting
ExecStart=/home/lance/Blockhead.Consulting/bin/blockhead-server
Restart=always
RestartSec=5
EnvironmentFile=/home/lance/Blockhead.Consulting/.env

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
